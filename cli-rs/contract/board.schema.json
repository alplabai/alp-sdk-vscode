{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alplabai/alp-sdk-vscode/cli-rs/contract/board.schema.json",
  "title": "ALP board.yaml contract schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "som": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sku"],
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "carrier": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "populated": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "os": {
      "type": "string"
    },
    "cores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/coreEntry"
      }
    },
    "ipc": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ipcCarveOut"
      }
    },
    "inference": {
      "$ref": "#/$defs/inference"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "iot": {
      "$ref": "#/$defs/iot"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "last_error": {
          "type": "boolean"
        },
        "log_level": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "coreEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "os": {
          "enum": ["zephyr", "yocto", "baremetal", "off"]
        },
        "app": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "peripherals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inference": {
          "$ref": "#/$defs/inference"
        },
        "iot": {
          "$ref": "#/$defs/iot"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "backend": {
          "type": "string"
        },
        "default_arena_kib": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "iot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wifi": {
          "type": "boolean"
        },
        "mqtt": {
          "type": "boolean"
        },
        "ble": {
          "type": "boolean"
        },
        "tls": {
          "type": "boolean"
        }
      }
    },
    "ipcCarveOut": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "endpoints", "size_kib"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size_kib": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 2
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "required": ["os"]
        },
        "required": ["cores"]
      }
    }
  ]
}
