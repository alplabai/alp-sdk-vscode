{
  "name": "@alplabai/alp-cli",
  "version": "0.1.12",
  "description": "ALP SDK command-line tool (native `alp` binary). Installs the platform-specific binary from the matching GitHub release.",
  "bin": {
    "alp": "bin/alp.js"
  },
  "scripts": {
    "postinstall": "node postinstall.js"
  },
  "files": [
    "bin/",
    "postinstall.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "alp-sdk",
    "embedded",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alplabai/alp-sdk-vscode.git",
    "directory": "cli-rs/npm-shim"
  },
  "homepage": "https://github.com/alplabai/alp-sdk-vscode"
}
