    {
      "path": "build/alp_sysbuild.conf",
      "contents": "# Auto-generated by scripts/alp_orchestrate.py from board.yaml `boot:`.\n# Drives the sysbuild MCUboot child image.  Customers who\n# omit `boot:` get the SDK's stock per-family defaults.\n\nSB_CONFIG_BOOTLOADER_MCUBOOT=y\nSB_CONFIG_MCUBOOT_SIGNATURE_TYPE_ECDSA_P256=y\nSB_CONFIG_BOOT_SIGNATURE_KEY_FILE=\"keys/prod_ecdsa_p256.pub.pem\"\nSB_CONFIG_BOOT_PRIMARY_PARTITION_SIZE=1048576\nSB_CONFIG_BOOT_SECONDARY_PARTITION_SIZE=1048576\nSB_CONFIG_MCUBOOT_MODE_SWAP_USING_SCRATCH=y\nSB_CONFIG_BOOT_SCRATCH_PARTITION_SIZE=65536\nSB_CONFIG_BOOT_COUNTERS_MCUBOOT=y\n"
