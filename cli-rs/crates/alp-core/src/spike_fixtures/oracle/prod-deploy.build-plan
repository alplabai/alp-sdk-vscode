      "contents": "/*\n * Auto-generated by scripts/alp_orchestrate.py -- do not edit.\n * Regenerate after changes to board.yaml `storage:` or the SoM's\n * memory_map / on_module.ospi_memories blocks.  #include this file\n * from your Zephyr DT.\n */\n\n&mram_main {\n    partitions {\n        compatible = \"fixed-partitions\";\n        #address-cells = <1>;\n        #size-cells = <1>;\n\n        app_data_partition: partition@0 {\n            label = \"app_data\";\n            reg = <0x0 0x40000>;\n        };\n\n        mcuboot_primary_partition: partition@40000 {\n            label = \"mcuboot_primary\";\n            reg = <0x40000 0x100000>;\n        };\n\n        mcuboot_scratch_partition: partition@140000 {\n            label = \"mcuboot_scratch\";\n            reg = <0x140000 0x10000>;\n        };\n\n        mcuboot_secondary_partition: partition@150000 {\n            label = \"mcuboot_secondary\";\n            reg = <0x150000 0x100000>;\n        };\n\n        settings_partition: partition@250000 {\n            label = \"settings\";\n            reg = <0x250000 0x10000>;\n        };\n\n    };\n};\n"
