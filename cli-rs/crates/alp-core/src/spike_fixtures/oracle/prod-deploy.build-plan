      "path": "build/sysbuild/tfm/tfm.conf",
      "contents": "# Auto-generated by scripts/alp_orchestrate.py from board.yaml `security.psa:`.\n# Drives the sysbuild TF-M child image on the M55-HP core via Armv8-M TrustZone-M.\n# See docs/adr/0013-tfm-boundary-m55-hp-trustzone.md and docs/security-audit-plan.md.\n\nSB_CONFIG_TFM=y\nSB_CONFIG_TFM_BUILD_TYPE=Release\nCONFIG_PSA_CRYPTO_PERSISTENT_SLOT_COUNT=32\nCONFIG_PSA_CRYPTO_ITS_BACKING_STORE=\"mram_main\"\nCONFIG_PSA_CRYPTO_PS_BACKING_STORE=\"ospi0\"\n# Attestation root anchored in OPTIGA Trust M (on-module secure element).\n# See src/security/optiga_trust_m_bridge.c for the PSA <-> OPTIGA bridge driver.\nCONFIG_ALP_SDK_PSA_ATTESTATION_OPTIGA=y\n"
