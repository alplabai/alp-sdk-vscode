# Auto-generated by scripts/alp_orchestrate.py -- do not edit.
# Per-core Kconfig fragment for slice `m55_hp` (zephyr).

CONFIG_ALP_SDK=y
CONFIG_LOG=y
CONFIG_PRINTK=y
CONFIG_THREAD_LOCAL_STORAGE=y
CONFIG_LOG_DEFAULT_LEVEL=2

# SoM silicon (alif:ensemble:e7 via E1M-AEN701)
CONFIG_ALP_SOC_ALIF_ENSEMBLE_E7=y

# Cross-EVK board facade selector (<alp/board.h>); CONFIG_COMPILER_OPT is single-value (do not also set in prj.conf).
CONFIG_COMPILER_OPT="-DALP_BOARD_E1M_EVK"

# SoM-intrinsic chip drivers (from `E1M-AEN701` on_module + helper_firmware)
CONFIG_ALP_SDK_CHIP_CC3501E=y
CONFIG_ALP_SDK_CHIP_EEPROM_24C128=y
CONFIG_ALP_SDK_CHIP_OPTIGA_TRUST_M=y
CONFIG_ALP_SDK_CHIP_RV3028C7=y
CONFIG_ALP_SDK_CHIP_TMP112=y

# Board-populated chip drivers (from the resolved board definition)
CONFIG_ALP_SDK_CHIP_BME280=n
CONFIG_ALP_SDK_CHIP_BMI323=y
CONFIG_ALP_SDK_CHIP_BMP581=y
CONFIG_ALP_SDK_BLOCK_BUTTON_LED=y
CONFIG_ALP_SDK_CHIP_CAM_MUX_PI3WVR626=y
CONFIG_ALP_SDK_CHIP_ICM42670=y
CONFIG_ALP_SDK_CHIP_INA236=y
CONFIG_ALP_SDK_CHIP_LIS2DW12=n
CONFIG_ALP_SDK_CHIP_LSM6DSO=y
CONFIG_ALP_SDK_CHIP_OV5640=n
CONFIG_ALP_SDK_BLOCK_PDM_MIC=y
CONFIG_ALP_SDK_CHIP_SSD1306=y
CONFIG_ALP_SDK_CHIP_SSD1331=n
CONFIG_ALP_SDK_CHIP_TAS2563=y
CONFIG_ALP_SDK_CHIP_TCAL9538=y

# Zephyr subsystems required on core `m55_hp` (chip drivers + peripherals)
CONFIG_GPIO=y
CONFIG_I2C=y
CONFIG_SPI=y

# Libraries declared on core `m55_hp`
CONFIG_MBEDTLS=y
CONFIG_MBEDTLS_BUILTIN=y
CONFIG_ALP_MBEDTLS_PURE_C=y

# Inference dispatchers (from SoM capabilities -- customer does not pick)
CONFIG_ALP_SDK_INFERENCE_BACKEND_TFLM=y
CONFIG_ALP_SDK_INFERENCE_TFLM_KERNEL_HELIUM=y
CONFIG_ALP_SDK_INFERENCE_BACKEND_ETHOS_U_AEN=y
CONFIG_ALP_SDK_INFERENCE_ETHOS_U_VARIANT_U55=y

# Per-slice memory tuning (board.yaml cores.<id>.memory:)
CONFIG_MAIN_STACK_SIZE=8192
CONFIG_ISR_STACK_SIZE=4096
CONFIG_HEAP_MEM_POOL_SIZE=65536

# Per-slice power-management profile (board.yaml cores.<id>.power:)
CONFIG_PM=y
CONFIG_PM_DEVICE=y
# Sleep target: standby
# wakeup source: uart (DT wakeup-source; + pm_device_wakeup_enable() pending v0.7)
# wakeup source: gpio (DT wakeup-source; + pm_device_wakeup_enable() pending v0.7)
# wakeup source: rtc (DT wakeup-source; + pm_device_wakeup_enable() pending v0.7)

# Storage partitions (board.yaml `storage:`)
CONFIG_FILE_SYSTEM=y
CONFIG_FILE_SYSTEM_LITTLEFS=y
# partition[app_data] -> mount at runtime via FIXED_PARTITION_ID(app_data_partition)
# partition[settings] -> mount at runtime via FIXED_PARTITION_ID(settings_partition)

# OTA Zephyr client (board.yaml `ota.provider: mender`)
# Mender-MCU-client wiring is pending the v0.7 OTA module
# (mender-mcu-client west group activation).
# CONFIG_MENDER_MCU_CLIENT=y
# CONFIG_MENDER_SERVER_URL="https://hosted.mender.io"
# CONFIG_MENDER_TENANT_TOKEN="${MENDER_TENANT_TOKEN}"
# CONFIG_MENDER_ARTIFACT_NAME="production-deployment"
# CONFIG_MENDER_UPDATE_POLL_INTERVAL=1800

# Per-module log-level overrides (board.yaml diagnostics.modules:)
# CONFIG_ALP_GPIO_LOG_LEVEL=2 (pending LOG_MODULE_REGISTER on this SDK module)
# CONFIG_ALP_INFERENCE_LOG_LEVEL=2 (pending LOG_MODULE_REGISTER on this SDK module)
# CONFIG_ALP_IOT_LOG_LEVEL=3 (pending LOG_MODULE_REGISTER on this SDK module)
# CONFIG_ALP_SECURITY_LOG_LEVEL=3 (pending LOG_MODULE_REGISTER on this SDK module)
# CONFIG_ALP_STORAGE_LOG_LEVEL=2 (pending LOG_MODULE_REGISTER on this SDK module)

