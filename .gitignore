# Node / TypeScript
node_modules/
out/
*.vsix
package-lock.json

# Build outputs
dist/
*.tsbuildinfo
*.tgz

# Local editor + OS clutter
.vscode/settings.json
.DS_Store
Thumbs.db

# Build / test scratch
coverage/
.nyc_output/

# tan's published envelope contract, fetched by scripts/fetch-tan-contract.mjs.
# Deliberately NOT tracked: a corpus hand-copied into this repo drifts in exactly
# the way the drift gate that reads it exists to catch. Refresh with
# `pnpm run contract:fetch`.
test/golden/tan-contract/

# Local assistant instructions (keep private)
.github/local-agent-instructions.md

# Claude Code project instructions. Untracked on purpose: the alp-lab plugin
# rewrites a managed block into this file on every session, so a tracked copy
# shows up as an unstaged edit forever. Root-scoped (`/`) so a nested CLAUDE.md
# in a package stays visible if one is ever added.
/CLAUDE.md

# Transient Claude Code runtime locks
.claude/scheduled_tasks.lock

# Per-machine Claude Code settings (never shared; also the last thing that
# made repo-wide `pnpm run format:check` fail on a clean checkout)
.claude/settings.local.json

# Claude Code agent worktrees — FULL repo copies incl. node_modules. Never
# commit these; `git add .claude` would otherwise pull in the whole tree.
.claude/worktrees/
.claude/alp-tasks.json

# VS Code e2e test runtime (downloaded VS Code + user data)
.vscode-test/

# Cygwin/MSYS bash crash dumps (Windows dev hosts)
*.stackdump

# Retired in-repo Rust CLI (superseded by the standalone tan-cli repo) —
# read-only local reference only, never tracked here.
cli-rs/
