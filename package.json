{
  "name": "alp-sdk",
  "displayName": "Alp IDE",
  "packageManager": "pnpm@11.1.0",
  "description": "First-class IDE support for Alp SDK projects: board.yaml schema-aware editing, alp_project.py loader commands, per-OS dependency bootstrap, and west build/flash/run workflows.",
  "version": "0.5.1",
  "publisher": "AlpLabAI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alplabai/alp-sdk-vscode.git",
    "directory": "."
  },
  "homepage": "https://github.com/alplabai/alp-sdk-vscode",
  "bugs": {
    "url": "https://github.com/alplabai/alp-sdk-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "alp-sdk",
    "embedded",
    "zephyr",
    "yocto",
    "alif",
    "renesas",
    "nxp"
  ],
  "activationEvents": [
    "onView:alp-ide.hub",
    "onCommand:alp.openSdkManager",
    "onCommand:alp.openSetupFlow",
    "onCommand:alp.openHub",
    "onCommand:alp.openOverview",
    "onCommand:alp.newProjectWizard",
    "onCommand:alp.openExistingProject",
    "onLanguage:yaml",
    "onTaskType:alp",
    "workspaceContains:**/board.yaml",
    "workspaceContains:**/prj*.conf"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Alp IDE executes programs against the files in your workspace: it spawns the `tan` CLI, `west`, and your cross-toolchain, driven by workspace-controlled inputs (board.yaml, CMakeLists, west manifests, .vscode/settings.json). Opening a folder you do not trust could therefore run code you did not write. Trust this folder to enable Alp IDE."
    }
  },
  "extensionDependencies": [
    "redhat.vscode-yaml",
    "marus25.cortex-debug"
  ],
  "extensionPack": [
    "ms-vscode.cpptools",
    "vadimcn.vscode-lldb"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "alp.boardConfigurator",
        "displayName": "Alp Board Configurator",
        "selector": [
          {
            "filenamePattern": "**/board.yaml"
          }
        ],
        "priority": "option"
      }
    ],
    "walkthroughs": [
      {
        "id": "alpGettingStarted",
        "title": "Get started with Alp IDE",
        "description": "Install the SDK, open a project, bootstrap your toolchain, and build — all from here.",
        "steps": [
          {
            "id": "alp.walkthrough.installSdk",
            "title": "Install the Alp SDK",
            "description": "Pick a tagged SDK release, or point at one you already have on disk. Installing is not activating: then click **Use** on the installed release to make it active. The active SDK supplies the board schemas, presets, and build-plan emitter.\n[Open SDK Manager](command:alp.openSdkManager)\n[Select an SDK on disk](command:alp.selectSdk)",
            "media": {
              "markdown": "media/walkthroughs/01-install-sdk.md"
            },
            "completionEvents": [
              "onSettingChanged:alpSdk.path"
            ]
          },
          {
            "id": "alp.walkthrough.project",
            "title": "Open or create a project",
            "description": "Scaffold a real project from a template (and target your SoM), or open an existing folder. Do this before bootstrapping — bootstrap needs an open project folder to work from.\n[New project](command:alp.newProjectWizard)\n[Open existing](command:alp.openExistingProject)",
            "media": {
              "markdown": "media/walkthroughs/02-project.md"
            },
            "completionEvents": [
              "onCommand:alp.newProjectWizard",
              "onCommand:alp.openExistingProject"
            ]
          },
          {
            "id": "alp.walkthrough.bootstrap",
            "title": "Bootstrap your toolchain",
            "description": "With your project folder open, create the Zephyr workspace and install west + Zephyr Python deps into a workspace venv. Dependencies lists every host tool tan checks (CMake, Ninja, the Zephyr SDK, …) with the status tan reported for each.\n[Bootstrap toolchain](command:alp.installDependencies)\n[Open Dependencies](command:alp.openDependencies)",
            "media": {
              "markdown": "media/walkthroughs/03-bootstrap.md"
            },
            "completionEvents": [
              "onCommand:alp.installDependencies"
            ]
          },
          {
            "id": "alp.walkthrough.build",
            "title": "Build & flash",
            "description": "Preview the build plan, then build and flash — also available from the status bar and the Build & Flash section of the Alp IDE panel.\n[Preview build plan](command:alp.showBuildPlan)\n[Build](command:alp.westBuild)\n[Flash](command:alp.westAlpFlash)",
            "media": {
              "markdown": "media/walkthroughs/04-build.md"
            },
            "completionEvents": [
              "onCommand:alp.westBuild"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "alp.generateZephyrConf",
        "title": "Alp: Generate alp.conf (zephyr-conf)",
        "category": "Alp"
      },
      {
        "command": "alp.generateDtsOverlay",
        "title": "Alp: Generate alp.overlay (dts-overlay)",
        "category": "Alp"
      },
      {
        "command": "alp.generateNativeSimOverlay",
        "title": "Alp: Generate native_sim overlay (native-sim-overlay)",
        "category": "Alp"
      },
      {
        "command": "alp.generateCmakeArgs",
        "title": "Alp: Generate alp-cmake-args.txt (cmake-args)",
        "category": "Alp"
      },
      {
        "command": "alp.generateYoctoConf",
        "title": "Alp: Generate alp-yocto.conf (yocto-conf)",
        "category": "Alp"
      },
      {
        "command": "alp.generateAll",
        "title": "Alp: Generate all (zephyr-conf + dts-overlay + cmake-args + yocto-conf)",
        "category": "Alp"
      },
      {
        "command": "alp.validateBoardYaml",
        "title": "Alp: Validate board.yaml",
        "category": "Alp"
      },
      {
        "command": "alp.installDependencies",
        "title": "Alp: Bootstrap SDK environment (Zephyr + build deps)",
        "category": "Alp"
      },
      {
        "command": "alp.westBuild",
        "title": "Alp: Build (validate + generate + build)",
        "category": "Alp"
      },
      {
        "command": "alp.westFlash",
        "title": "Alp: Flash (single image)",
        "category": "Alp"
      },
      {
        "command": "alp.westUpdate",
        "title": "Alp: Update workspace",
        "category": "Alp"
      },
      {
        "command": "alp.westRunNativeSim",
        "title": "Alp: Run under native_sim",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpImage",
        "title": "Alp: Build image (assemble image bundle)",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpFlash",
        "title": "Alp: Flash (all slices)",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpClean",
        "title": "Alp: Clean build (remove build dir)",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpRenode",
        "title": "Alp: Run in Renode (simulate)",
        "category": "Alp"
      },
      {
        "command": "alp.openConfigurator",
        "title": "Alp: Open board configurator (GUI)",
        "category": "Alp",
        "icon": "$(circuit-board)"
      },
      {
        "command": "alp.openDependencies",
        "title": "Alp: Dependencies",
        "category": "Alp",
        "icon": "$(checklist)"
      },
      {
        "command": "alp.toolchainDoctor",
        "title": "Alp: Toolchain doctor (opens Dependencies)",
        "category": "Alp"
      },
      {
        "command": "alp.openHardwareExplorer",
        "title": "Alp: Hardware Explorer",
        "category": "Alp"
      },
      {
        "command": "alp.showBuildPlan",
        "title": "Alp: Preview build plan",
        "category": "Alp",
        "icon": "$(list-tree)"
      },
      {
        "command": "alp.openGettingStarted",
        "title": "Alp: Get started (walkthrough)",
        "category": "Alp"
      },
      {
        "command": "alp.selectSdk",
        "title": "Alp: Select active SDK",
        "category": "Alp",
        "icon": "$(package)"
      },
      {
        "command": "alp.showOutput",
        "title": "Alp: Show output log",
        "category": "Alp",
        "icon": "$(output)"
      },
      {
        "command": "alp.updateCli",
        "title": "Alp: Reinstall the pinned tan CLI",
        "category": "Alp",
        "icon": "$(cloud-download)"
      },
      {
        "command": "alp.installTanCli",
        "title": "Alp: Install tan CLI (global)",
        "category": "Alp",
        "icon": "$(cloud-download)"
      },
      {
        "command": "alp.newProjectWizard",
        "title": "Alp: New project wizard",
        "category": "Alp"
      },
      {
        "command": "alp.scaffoldModule",
        "title": "Alp: Scaffold module",
        "category": "Alp"
      },
      {
        "command": "alp.previewEffectiveConfig",
        "title": "Alp: Preview effective config (LSP)",
        "category": "Alp"
      },
      {
        "command": "alp.inspectProjectState",
        "title": "Alp: Inspect project state",
        "category": "Alp"
      },
      {
        "command": "alp.debugDoctor",
        "title": "Alp: Debug doctor",
        "category": "Alp"
      },
      {
        "command": "alp.debugPreflight",
        "title": "Alp: Debug preflight",
        "category": "Alp"
      },
      {
        "command": "alp.configureDebugProfile",
        "title": "Alp: Configure debug profile (launch.json)",
        "category": "Alp"
      },
      {
        "command": "alp.debug",
        "title": "Alp: Debug (generate profile + start session)",
        "category": "Alp",
        "icon": "$(debug-alt)"
      },
      {
        "command": "alp.exportSupportBundle",
        "title": "Alp: Export debug support bundle",
        "category": "Alp"
      },
      {
        "command": "alp.openDebugTroubleshootingPanel",
        "title": "Alp: Open troubleshooting panel",
        "category": "Alp"
      },
      {
        "command": "alp.ideHub.focus",
        "title": "Alp: Open Alp IDE panel",
        "category": "Alp"
      },
      {
        "command": "alp.openSetupFlow",
        "title": "Alp: Open setup wizard",
        "category": "Alp"
      },
      {
        "command": "alp.openHub",
        "title": "Alp: Open Hub",
        "category": "Alp"
      },
      {
        "command": "alp.openOverview",
        "title": "Alp: Open Hub (deprecated alias)",
        "category": "Alp"
      },
      {
        "command": "alp.openExistingProject",
        "title": "Alp: Open Existing Alp Project",
        "category": "Alp"
      },
      {
        "command": "alp.openSdkManager",
        "title": "Alp: SDK Manager",
        "category": "Alp"
      },
      {
        "command": "alp.switchWorkspace",
        "title": "Alp: Switch workspace folder",
        "category": "Alp"
      },
      {
        "command": "alp.removeWestInit",
        "title": "Alp: Reset workspace (.west/)",
        "category": "Alp"
      },
      {
        "command": "alp.openSettings",
        "title": "Alp: Open Alp IDE settings",
        "category": "Alp"
      },
      {
        "command": "alp.views.refresh",
        "title": "Alp: Refresh sidebar views",
        "icon": "$(refresh)",
        "category": "Alp"
      }
    ],
    "taskDefinitions": [
      {
        "type": "alpRun",
        "required": [
          "run"
        ],
        "properties": {
          "run": {
            "type": "string"
          }
        }
      },
      {
        "type": "alp",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alp-ide",
          "title": "Alp IDE",
          "icon": "media/bolt.svg"
        }
      ]
    },
    "views": {
      "alp-ide": [
        {
          "type": "webview",
          "id": "alp-ide.hub",
          "name": "Alp IDE"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "alp.toolchainDoctor",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "alp.openConfigurator",
          "when": "resourceFilename == board.yaml && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "alp.openConfigurator",
          "when": "resourceFilename == board.yaml",
          "group": "navigation"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": "board.yaml",
        "url": "./schemas/board.schema.json"
      },
      {
        "fileMatch": "system-manifest.yaml",
        "url": "./schemas/system-manifest-v1.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/board-yaml.json"
      }
    ],
    "languages": [
      {
        "id": "prj-conf",
        "aliases": [
          "Zephyr prj.conf",
          "prj-conf"
        ],
        "filenamePatterns": [
          "prj*.conf"
        ],
        "configuration": "./syntaxes/prj-conf.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "prj-conf",
        "scopeName": "source.prj-conf",
        "path": "./syntaxes/prj-conf.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Alp IDE",
      "properties": {
        "alpSdk.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the alp-sdk repository checkout.  When empty, the extension searches the workspace for the SDK root (a directory containing scripts/alp_project.py)."
        },
        "alpSdk.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Python interpreter to use for the loader + validator.  Defaults to `python3` (POSIX) / `python` (Windows)."
        },
        "alpSdk.boardYamlPath": {
          "type": "string",
          "default": "board.yaml",
          "scope": "resource",
          "description": "Path (relative to its workspace folder) of the board.yaml the loader operates on. Settable per-folder via .vscode/settings.json in a multi-root workspace."
        },
        "alpSdk.westCwd": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Working directory for `west build/flash/run`.  When empty, defaults to the workspace root."
        },
        "alpSdk.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the native `tan` CLI binary. When empty, the extension resolves its own managed copy first (a bundled binary, a locally built sibling `tan-cli` checkout, or a previously downloaded copy cached in global storage), then a `tan` on PATH whose `--version` identifies it as a native build, and only then downloads the matching release into global storage. Point this at a local dev build (e.g. `../tan-cli/target/release/tan`) to override."
        },
        "alpSdk.preferGlobalCli": {
          "type": "boolean",
          "default": false,
          "scope": "machine-overridable",
          "markdownDescription": "Prefer a globally-installed native `tan` on your PATH over the extension's own managed copy. Use this if you installed tan with **Install tan CLI (global)** and want the extension to run the same binary as your terminal. An explicit `#alpSdk.cliPath#` still takes precedence. Default (off): the extension uses its private, version-pinned managed copy."
        },
        "alpSdk.tanCliDownloadConsent": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ],
          "enumDescriptions": [
            "Show a one-time consent dialog (artifact, source, size, licence) the first time nothing else resolves a tan CLI. Your answer is remembered, so this asks only once.",
            "Skip the dialog and allow the download. For a managed/CI image that already vetted it.",
            "Skip the dialog and refuse a first-time download; tan stays unresolved until you set alpSdk.cliPath, or run \"Install tan CLI (global)\" / \"Update tan CLI\", which proceed regardless of this setting. Does NOT stop a stale-cache self-update or the one-time re-verification of a binary cached before checksums were recorded — both act on a tan you already have and are never gated by this setting."
          ],
          "default": "ask",
          "scope": "machine-overridable",
          "markdownDescription": "Whether the extension may download the managed `tan` CLI binary the first time nothing else resolves it. Only governs that FIRST install: a stale-cache self-update and the one-time re-verification of a binary cached before this extension recorded checksums are never gated by this setting — both act on a `tan` you already have. `#alpSdk.cliPath#` and the **Install tan CLI (global)** / **Update tan CLI** commands are unaffected either way."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --build && pnpm --filter ./packages/alp-webview run build",
    "vendor:kconfig-metadata": "node scripts/vendor-kconfig-metadata.mjs",
    "contract:fetch": "node scripts/fetch-tan-contract.mjs",
    "compile:watch": "tsc --build --watch",
    "typecheck": "tsc --noEmit -p packages/alp-core --tsBuildInfoFile node_modules/.cache/alp-core.typecheck.tsbuildinfo && tsc --noEmit -p tsconfig.json && pnpm --filter ./packages/alp-webview run typecheck",
    "bundle:ext": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=out/extension.js --format=cjs --sourcemap && esbuild src/lsp/server.ts --bundle --platform=node --target=node18 --outfile=out/lsp/server.js --format=cjs --sourcemap && node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "pnpm run compile && node --test test/*.test.js",
    "install:vscode": "node scripts/run-bash.mjs ./scripts/install-vscode.sh",
    "watch": "tsc --build --watch",
    "vscode:prepublish": "pnpm --filter ./packages/alp-webview run build && tsc --build && pnpm run bundle:ext",
    "package": "vsce package --no-dependencies",
    "package:dev": "vsce package --no-dependencies --pre-release",
    "publish:vsix": "vsce publish --no-dependencies",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm run compile && pnpm run bundle:ext && node test/e2e/runTest.js",
    "test:e2e:cli": "node scripts/run-bash.mjs test/e2e/cli-smoke.sh",
    "test:e2e:webview": "node test/webview/run.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  },
  "dependencies": {
    "@alp-sdk/core": "workspace:*",
    "js-yaml": "^4.1.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.15",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "typescript": "^7.0.2"
  }
}
