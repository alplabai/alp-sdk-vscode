{
  "name": "alp-sdk",
  "displayName": "ALP SDK",
  "packageManager": "pnpm@11.1.0",
  "description": "First-class IDE support for ALP SDK projects: board.yaml schema-aware editing, alp_project.py loader commands, per-OS dependency bootstrap, and west build/flash/run workflows.",
  "version": "0.3.0",
  "publisher": "alplabai",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alplabai/alp-sdk-vscode.git",
    "directory": "."
  },
  "homepage": "https://github.com/alplabai/alp-sdk-vscode",
  "bugs": {
    "url": "https://github.com/alplabai/alp-sdk-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "alp-sdk",
    "embedded",
    "zephyr",
    "yocto",
    "alif",
    "renesas",
    "nxp"
  ],
  "activationEvents": [
    "onView:alp-ide.panel",
    "onLanguage:yaml",
    "workspaceContains:**/board.yaml"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "alp.generateZephyrConf",
        "title": "Alp: Generate alp.conf (zephyr-conf)",
        "category": "Alp"
      },
      {
        "command": "alp.generateDtsOverlay",
        "title": "Alp: Generate alp.overlay (dts-overlay)",
        "category": "Alp"
      },
      {
        "command": "alp.generateCmakeArgs",
        "title": "Alp: Generate alp-cmake-args.txt (cmake-args)",
        "category": "Alp"
      },
      {
        "command": "alp.generateYoctoConf",
        "title": "Alp: Generate alp-yocto.conf (yocto-conf)",
        "category": "Alp"
      },
      {
        "command": "alp.generateAll",
        "title": "Alp: Generate all (zephyr-conf + dts-overlay + cmake-args + yocto-conf)",
        "category": "Alp"
      },
      {
        "command": "alp.validateBoardYaml",
        "title": "Alp: Validate board.yaml",
        "category": "Alp"
      },
      {
        "command": "alp.installDependencies",
        "title": "Alp: Install dependencies (per-OS)",
        "category": "Alp"
      },
      {
        "command": "alp.westBuild",
        "title": "Alp: West build (validate + generate + build)",
        "category": "Alp"
      },
      {
        "command": "alp.westFlash",
        "title": "Alp: West flash",
        "category": "Alp"
      },
      {
        "command": "alp.westUpdate",
        "title": "Alp: West update (fetch and update modules)",
        "category": "Alp"
      },
      {
        "command": "alp.westRunNativeSim",
        "title": "Alp: Run under native_sim",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpImage",
        "title": "Alp: West alp-image (assemble image bundle)",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpFlash",
        "title": "Alp: West alp-flash (flash all slices)",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpClean",
        "title": "Alp: West alp-clean (remove build dir)",
        "category": "Alp"
      },
      {
        "command": "alp.westAlpRenode",
        "title": "Alp: West alp-renode (simulate in Renode)",
        "category": "Alp"
      },
      {
        "command": "alp.openConfigurator",
        "title": "Alp: Open board configurator (GUI)",
        "category": "Alp"
      },
      {
        "command": "alp.newProjectWizard",
        "title": "Alp: New project wizard",
        "category": "Alp"
      },
      {
        "command": "alp.scaffoldModule",
        "title": "Alp: Scaffold module",
        "category": "Alp"
      },
      {
        "command": "alp.previewEffectiveConfig",
        "title": "Alp: Preview effective config (LSP)",
        "category": "Alp"
      },
      {
        "command": "alp.inspectProjectState",
        "title": "Alp: Inspect project state",
        "category": "Alp"
      },
      {
        "command": "alp.debugDoctor",
        "title": "Alp: Debug doctor",
        "category": "Alp"
      },
      {
        "command": "alp.debugPreflight",
        "title": "Alp: Debug preflight",
        "category": "Alp"
      },
      {
        "command": "alp.configureDebugProfile",
        "title": "Alp: Configure debug profile (launch.json)",
        "category": "Alp"
      },
      {
        "command": "alp.exportSupportBundle",
        "title": "Alp: Export debug support bundle",
        "category": "Alp"
      },
      {
        "command": "alp.openDebugTroubleshootingPanel",
        "title": "Alp: Open troubleshooting panel",
        "category": "Alp"
      },
      {
        "command": "alp.ideHub.refresh",
        "title": "Alp: Refresh ALP IDE panel",
        "category": "Alp",
        "icon": "$(refresh)"
      },
      {
        "command": "alp.ideHub.focus",
        "title": "Alp: Open ALP IDE panel",
        "category": "Alp"
      },
      {
        "command": "alp.openSetupFlow",
        "title": "Alp: Open setup wizard",
        "category": "Alp"
      },
      {
        "command": "alp.openOverview",
        "title": "Alp: Open ALP IDE overview",
        "category": "Alp"
      },
      {
        "command": "alp.newProjectWizard",
        "title": "Alp: New Project Wizard",
        "category": "Alp"
      },
      {
        "command": "alp.openExistingProject",
        "title": "Alp: Open Existing ALP Project",
        "category": "Alp"
      },
      {
        "command": "alp.openSdkManager",
        "title": "ALP: SDK Manager",
        "category": "Alp"
      },
      {
        "command": "alp.switchWorkspace",
        "title": "Alp: Switch workspace folder",
        "category": "Alp"
      },
      {
        "command": "alp.removeWestInit",
        "title": "Alp: Remove west initialization (.west/)",
        "category": "Alp"
      },
      {
        "command": "alp.openSettings",
        "title": "Alp: Open ALP IDE settings",
        "category": "Alp"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alp-ide",
          "title": "ALP IDE",
          "icon": "media/alp-ide-icon.svg"
        }
      ]
    },
    "views": {
      "alp-ide": [
        {
          "type": "webview",
          "id": "alp-ide.panel",
          "name": "ALP IDE",
          "retainContextWhenHidden": true
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "alp.ideHub.refresh",
          "when": "view == alp-ide.panel",
          "group": "navigation"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": "board.yaml",
        "url": "./alp-sdk-upstream/metadata/schemas/board-config-v2.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/board-yaml.json"
      }
    ],
    "configuration": {
      "title": "ALP SDK",
      "properties": {
        "alpSdk.path": {
          "type": "string",
          "default": "",
          "description": "Path to the alp-sdk repository checkout.  When empty, the extension searches the workspace for the SDK root (a directory containing scripts/alp_project.py)."
        },
        "alpSdk.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to use for the loader + validator.  Defaults to `python3` (POSIX) / `python` (Windows)."
        },
        "alpSdk.boardYamlPath": {
          "type": "string",
          "default": "board.yaml",
          "description": "Path (relative to the workspace root) of the board.yaml the loader operates on."
        },
        "alpSdk.westCwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for `west build/flash/run`.  When empty, defaults to the workspace root."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --build && pnpm --filter ./packages/alp-cli run compile && vp build",
    "compile:watch": "tsc --build --watch",
    "bundle:ext": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=out/extension.js --format=cjs --sourcemap && esbuild src/lsp/server.ts --bundle --platform=node --target=node18 --outfile=out/lsp/server.js --format=cjs --sourcemap",
    "cli:pack": "pnpm run compile && pnpm --filter ./packages/alp-cli run cli:pack",
    "cli:smoke": "bash ./scripts/ci/smoke-cli.sh",
    "test": "pnpm run compile && node --test test/*.test.js",
    "install:vscode": "bash ./scripts/install-vscode.sh",
    "watch": "tsc --build --watch",
    "vscode:prepublish": "pnpm --filter ./packages/alp-webview run build && tsc --build && pnpm --filter ./packages/alp-cli run compile && pnpm run bundle:ext",
    "package": "pnpm run vscode:prepublish && vsce package --no-dependencies",
    "package:dev": "pnpm run vscode:prepublish && vsce package --no-dependencies --pre-release"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  },
  "dependencies": {
    "@alp-sdk/core": "workspace:*",
    "js-yaml": "^4.1.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.15",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
