# Excerpt of a REAL Zephyr .config, captured from an alp-sample build of
# E1M-AEN801 slice m55_hp (build/m55_hp-zephyr/build/zephyr/.config).
# Trimmed for reviewability; every line below is byte-verbatim from that
# file. Covers each value shape the parser must handle: bool y, int,
# quoted string, and the `# CONFIG_X is not set` form (579 of those in the
# full file — the =n equivalence is the common case, not an edge case).
# CONFIG_NEWLIB_LIBC is absent ENTIRELY rather than 'is not set': the
# symbol does not exist in this build's tree at all, which is a distinct
# diagnostic from 'assigned but overridden'.

CONFIG_MAIN_STACK_SIZE=1024
CONFIG_SERIAL=y
CONFIG_ASSERT=y
CONFIG_CONSOLE=y
CONFIG_BOARD="alp_e1m_aen801_m55_hp"
CONFIG_BOARD_REVISION=""
CONFIG_BOARD_TARGET="alp_e1m_aen801_m55_hp/ae822fa0e5597ls0/rtss_hp"
CONFIG_BOARD_ALP_E1M_AEN801_M55_HP=y
CONFIG_BOARD_ALP_E1M_AEN801_M55_HP_AE822FA0E5597LS0_RTSS_HP=y
CONFIG_BOARD_QUALIFIERS="ae822fa0e5597ls0/rtss_hp"
CONFIG_HEAP_MEM_POOL_SIZE=0
CONFIG_CONSOLE_INPUT_MAX_LINE_LEN=128
CONFIG_CONSOLE_HAS_DRIVER=y
CONFIG_CONSOLE_INIT_PRIORITY=60
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL_HAS_DRIVER=y
CONFIG_SERIAL_SUPPORT_INTERRUPT=y
CONFIG_SERIAL_INIT_PRIORITY=50
CONFIG_PRINTK=y
CONFIG_ASSERT_LEVEL=2
CONFIG_ASSERT_VERBOSE=y

# CONFIG_ALP_SDK is not set
# CONFIG_DEBUG_DRIVER is not set
# CONFIG_DEBUG is not set
# CONFIG_DEBUG_THREAD_INFO is not set
# CONFIG_DEBUG_COREDUMP is not set
# CONFIG_DEBUG_OPTIMIZATIONS is not set
