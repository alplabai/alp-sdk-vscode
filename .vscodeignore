.git/**
.github/**
.vscode/**
.vscode-test/**

# Local tooling / agent artefacts — never ship in the VSIX. They exist only on
# developer machines (a fresh CI checkout has none), and vsce packages by the
# working tree, not .gitignore, so they must be excluded explicitly (#70).
.agents/**
.claude/**
.code-review-graph/**
.superpowers/**
.scratch/**
# `.alp/sdk-path` is per-workspace extension state holding a LOCAL ABSOLUTE path
# (e.g. C:/Users/<you>/.alp/sdk/v0.13.0). A dev-machine `pnpm run package` was
# shipping it inside the VSIX; CI's fresh checkout has none, so this never went
# red there. Public repo — no local paths in a published artifact.
.alp/**
# .remember/ is the agent history runtime dir (session buffers + daily logs, ~1 MB);
# it materializes only on a dev machine and must never ship in the VSIX (#297).
.remember/**
# Crash residue a Git-Bash tool can drop in the repo root (e.g. bash.exe.stackdump).
*.stackdump
# cli-rs was retired in #247 (extension shells the standalone tan CLI now); a dev
# machine that had it keeps the gitignored Rust build residue (~2.5 GB target/),
# which vsce would otherwise scan + pack. Exclude it explicitly.
cli-rs/**
AGENTS.md
.prettierignore
*.vsix

src/**
test/**
**/*.ts
**/*.map

node_modules/**
# Python venvs (e.g. an SDK bootstrap .venv) must never land in the VSIX — they
# add thousands of files. CI's fresh checkout has none, but exclude defensively
# so a local `pnpm run package`/`install:vscode` stays lean too.
.venv/**
**/.venv/**
packages/**
alp-sdk-upstream/**
dist/**
scripts/**

# NOTE: `bin/**` (root-level) is intentionally NOT excluded. The universal job
# in release-vsix.yml stages nothing there, so it ships nothing extra; the
# darwin-arm64 job stages the prebuilt `tan` binary at `bin/tan` before
# `vsce package --target darwin-arm64` so it ships in that targeted VSIX (the
# extension's `bundled` resolver source, src/alpCli, reads it from
# `<extensionPath>/bin/`). Do not add a `bin/**` exclusion above.

# README screenshots render from GitHub on the Marketplace (vsce rewrites the
# relative links) — keep them out of the VSIX so it stays lean. media/icon.png
# (the extension icon) is not under screenshots/, so it stays packaged.
media/screenshots/**

# Keep ALP IDE webview runtime bundle in the packaged extension.
!packages/alp-webview/dist/
!packages/alp-webview/dist/**
!packages/alp-webview/dist/main.js

.gitignore
.gitmodules
tsconfig.json
tsconfig.tsbuildinfo
package-lock.json
pnpm-lock.yaml
pnpm-workspace.yaml

docs/**
examples/**
CLAUDE.md
readme.md

packages/alp-webview/node_modules/**
packages/alp-core/node_modules/**
packages/**/src/**
packages/**/vite.config.*
packages/**/tsconfig*

# Design-system documentation and its sidecar — development context for
# contributors and tooling, not runtime assets. The Marketplace listing
# renders README.md; these would only inflate the VSIX and trip the
# top-level allowlist gate (#70).
PRODUCT.md
DESIGN.md
.impeccable/**
